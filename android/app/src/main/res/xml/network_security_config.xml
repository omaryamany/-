<?xml version="1.0" encoding="utf-8"?>
<!-- التلاوة بتتحفظ على الجهاز عن طريق وسيط محلي (127.0.0.1) — ده الاستثناء الوحيد من منع الـ HTTP -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- إذاعة القرآن من القاهرة والسعودية: البث بيتحوّل لسيرفرات radiojar على http -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">radiojar.com</domain>
    </domain-config>
</network-security-config>
